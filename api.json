{
   "openrpc":"1.2.4",
   "info":{
      "title":"GradidoNode JSON-RPC API",
      "version":"0.9.0",
      "description":"Public read-only JSON-RPC API for the Gradido blockchain node. All methods use HTTP POST with Content-Type application/json."
   },
   "servers":[
      {
         "name":"GradidoNodeApi Stage2",
         "url":"https://stage2.gradido.net/dlt",
         "description":"Staging instance - accepts only POST requests (no GET)."
      }
   ],
   "methods":[
      {
         "name":"listCommunities",
         "summary":"List all known communities",
         "params":[

         ],
         "result":{
            "name":"listCommunitiesResult",
            "schema":{
               "type":"object",
               "properties":{
                  "communities":{
                     "type":"array",
                     "items":{
                        "type":"object",
                        "properties":{
                           "communityId":{
                              "type":"string",
                              "format":"uuid"
                           },
                           "alias":{
                              "type":"string"
                           }
                        }
                     }
                  },
                  "timeUsed":{
                     "type":"string"
                  }
               },
               "required":[
                  "communities"
               ]
            }
         },
         "examples":[
            {
               "name":"example",
               "params":[

               ],
               "result":{
                  "name":"list1CommunityExample",
                  "value":{
                     "communities":[
                        {
                           "communityId":"e70da33e-5976-4767-bade-aa4e4fa1c01a",
                           "alias":"Gradido Development Stage2"
                        }
                     ],
                     "timeUsed":"1.6800 us"
                  }
               }
            }
         ]
      },
      {
         "name":"getLastTransaction",
         "summary":"Retrieve the most recent transaction",
         "params":[
            {
               "name":"format",
               "description":"Output format – base64 (default) or json",
               "schema":{
                  "type":"string",
                  "enum":[
                     "base64",
                     "json"
                  ]
               },
               "required":true
            },
            {
               "name":"communityId",
               "description":"Community UUID (must be a valid community)",
               "schema":{
                  "type":"string",
                  "format":"uuid"
               },
               "required":true
            }
         ],
         "result":{
            "name":"getLastTransactionResult",
            "schema":{
               "type":"object",
               "properties":{
                  "transaction":{
                     "description":"Transaction data in the requested format",
                     "oneOf":[
                        {
                           "type":"string",
                           "description":"Base64-encoded serialized transaction"
                        },
                        {
                           "type":"object",
                           "description":"JSON representation"
                        }
                     ]
                  },
                  "timeUsed":{
                     "type":"string"
                  }
               },
               "required":[
                  "transaction",
                  "timeUsed"
               ]
            }
         },
         "examples":[
            {
               "name":"Get last transaction as JSON",
               "params":[
                  {
                     "name":"format",
                     "value":"json"
                  },
                  {
                     "name":"communityId",
